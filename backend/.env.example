# AweerMarket Backend API Environment Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Reverse Proxy Trust Configuration (Fastify trustProxy)
# Default: false (proxy trust disabled; strictly uses raw socket IP, ignores X-Forwarded-For)
# For local development or direct server access, keep as: false
# For production behind a verified local reverse proxy (e.g. Nginx on Contabo):
#   Set to specific trusted IP or CIDR (e.g. 127.0.0.1 or loopback) after verifying
#   the proxy sets and sanitizes X-Forwarded-For headers.
#   NEVER blindly set to true in production without verifying strict upstream topology.
TRUST_PROXY=false

# Database (MongoDB connection string - local placeholder only)
MONGODB_URI=mongodb://localhost:27017/aweermarket_dev

# Allowed CORS Origins (comma separated)
# Local: http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100,http://localhost:3101,http://localhost:3102
# Production: https://barakahalrizquae.com,https://shop.barakahalrizquae.com,https://aweeradmin.barakahalrizquae.com,https://aweermarket.barakahalrizquae.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# JWT Secrets (Placeholders only - use cryptographically random strings in actual environment, minimum 32 chars)
JWT_SECRET=placeholder_secret_key_minimum_32_characters_long
ADMIN_JWT_SECRET=placeholder_admin_secret_key_minimum_32_characters_long
SUPER_ADMIN_JWT_SECRET=placeholder_super_admin_secret_key_minimum_32_chars

# Super Admin Initial Seeding (Optional, production requires explicit opt-in and password >= 12 chars)
ENABLE_SUPER_ADMIN_SEED=false
SUPER_ADMIN_EMAIL=superadmin@aweermarket.ae
SUPER_ADMIN_PASSWORD=placeholder_super_admin_password_min_12_chars
SUPER_ADMIN_NAME="Aweer Market Super Admin"

# Cloudflare R2 Product Image Storage (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=aweermarket-products
R2_PUBLIC_BASE_URL=https://images.aweermarket.ae
# Optional custom S3 endpoint override (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Product Image Upload Rate Limiting Configuration
# UPLOAD_RATE_LIMIT_WINDOW_MS: Sliding window duration in milliseconds (default: 60000 = 1 minute)
# UPLOAD_RATE_LIMIT_MAX_VENDOR: Maximum uploads allowed per authenticated vendor user per window (default: 20)
# UPLOAD_RATE_LIMIT_MAX_IP: Maximum aggregate uploads allowed per public IP per window (volumetric safeguard, default: 100)
# UPLOAD_RATE_LIMIT_WINDOW_MS=60000
# UPLOAD_RATE_LIMIT_MAX_VENDOR=20
# UPLOAD_RATE_LIMIT_MAX_IP=100
