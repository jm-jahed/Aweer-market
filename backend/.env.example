# AweerMarket Backend API Environment Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (MongoDB connection string - local placeholder only)
MONGODB_URI=mongodb://localhost:27017/aweermarket_dev

# Allowed CORS Origins (comma separated)
# Local: http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100,http://localhost:3101,http://localhost:3102
# Production: https://barakahalrizquae.com,https://shop.barakahalrizquae.com,https://aweeradmin.barakahalrizquae.com,https://aweermarket.barakahalrizquae.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# JWT Secrets (Placeholders only - use cryptographically random strings in actual environment, minimum 32 chars)
JWT_SECRET=placeholder_secret_key_minimum_32_characters_long
ADMIN_JWT_SECRET=placeholder_admin_secret_key_minimum_32_characters_long
SUPER_ADMIN_JWT_SECRET=placeholder_super_admin_secret_key_minimum_32_chars

# Super Admin Initial Seeding (Optional, production requires explicit opt-in and password >= 12 chars)
ENABLE_SUPER_ADMIN_SEED=false
SUPER_ADMIN_EMAIL=superadmin@aweermarket.ae
SUPER_ADMIN_PASSWORD=placeholder_super_admin_password_min_12_chars
SUPER_ADMIN_NAME="Aweer Market Super Admin"
